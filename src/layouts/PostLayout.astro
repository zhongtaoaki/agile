---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  type?: 'blog' | 'docs';
}

const { title, description, publishDate, updatedDate, category, tags, type = 'blog' } = Astro.props;

const formattedPublish = publishDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdated = updatedDate?.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const backHref = type === 'docs' ? `${base}/docs/` : `${base}/blog/`;
const backLabel = type === 'docs' ? 'Docs 一覧' : 'Blog 一覧';
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back link -->
    <a
      href={backHref}
      class="inline-flex items-center gap-1 text-sm text-accent-600 dark:text-accent-400 hover:underline mb-8 group"
    >
      <span class="group-hover:-translate-x-1 transition-transform inline-block">&larr;</span>
      {backLabel}
    </a>

    <!-- Article header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {category && (
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-accent-100 text-accent-700 dark:bg-accent-900 dark:text-accent-300">
            {category}
          </span>
        )}
        {tags?.map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400">
            #{tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white leading-tight mb-4">
        {title}
      </h1>

      {description && (
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-4">{description}</p>
      )}

      <div class="flex flex-wrap gap-4 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={publishDate.toISOString()}>
          公開: {formattedPublish}
        </time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>
            更新: {formattedUpdated}
          </time>
        )}
      </div>
    </header>

    <!-- Article content -->
    <article class="max-w-prose mx-auto prose prose-indigo dark:prose-invert prose-lg
      prose-headings:font-bold
      prose-a:text-accent-600 dark:prose-a:text-accent-400
      prose-code:text-accent-700 dark:prose-code:text-accent-300
      prose-pre:bg-gray-900 dark:prose-pre:bg-gray-950
      prose-img:rounded-xl
    ">
      <slot />
    </article>

    <!-- Back link (bottom) -->
    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
      <a
        href={backHref}
        class="inline-flex items-center gap-1 text-sm text-accent-600 dark:text-accent-400 hover:underline group"
      >
        <span class="group-hover:-translate-x-1 transition-transform inline-block">&larr;</span>
        {backLabel}に戻る
      </a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Shiki dual-theme support */
  .astro-code,
  .astro-code span {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }
  .dark .astro-code,
  .dark .astro-code span {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }

  .astro-code {
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>
