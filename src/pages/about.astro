---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    period: '2019 – 2021',
    type: 'fulltime',
    title: 'Java エンジニア',
    company: 'NTT DATA',
    location: '東京',
    description: 'アジャイルチームで大規模な金融システムのバックエンド開発・保守。',
  },
  {
    period: '2021 – 2023',
    type: 'partime',
    title: 'Java 講師',
    company: '研修会社 万葉',
    location: 'リモート',
    description: 'Java・アジャイル開発のトレーニングを提供。MBA課程と並行して実施。',
  },
  {
    period: '2023 – 2026',
    type: 'fulltime',
    title: 'アジャイルコンサルタント',
    company: 'MSOL Digital',
    location: '東京',
    description: 'スクラムマスターとしてチームの自己組織化を支援。',
  },
  {
    period: '2026 – 現在',
    type: 'fulltime',
    title: 'プロダクトエンジニア',
    company: '日本IBM',
    location: '東京',
    description: 'プロダクト開発とアジャイル推進を両立。',
  },
];

const education = [
  {
    period: '2021 – 2023',
    degree: '経営管理修士（MBA）',
    school: '京都大学経営管理大学院',
    major: 'プロジェクトオペレーションズマネジメント専攻',
    location: '京都',
  },
];

const skills = [
  { label: 'Agile / Scrum', level: 95 },
  { label: 'Java / Spring Boot', level: 90 },
  { label: 'デザインパターン', level: 88 },
  { label: 'TypeScript / React', level: 80 },
  { label: 'プロダクトマネジメント', level: 78 },
  { label: 'チームビルディング', level: 85 },
];
---

<BaseLayout title="About" description="Zhong Tao（鍾 涛）のプロフィール">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Profile Header -->
    <div class="bg-gradient-to-br from-accent-600 to-indigo-700 dark:from-accent-800 dark:to-indigo-900 rounded-2xl p-8 md:p-12 text-white mb-12">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <!-- Avatar placeholder -->
        <div class="w-32 h-32 rounded-full bg-white/20 flex items-center justify-center text-5xl font-bold shrink-0">
          ZT
        </div>
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold mb-1">Zhong Tao（鍾 涛）</h1>
          <p class="text-indigo-200 text-lg mb-4">Product Engineer / Agile Practitioner</p>
          <div class="flex flex-wrap gap-2">
            {['MBA', 'Java Instructor', 'Scrum Master', 'Consultant'].map((badge) => (
              <span class="px-3 py-1 bg-white/20 rounded-full text-sm font-medium">
                {badge}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bio -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">自己紹介</h2>
      <div class="prose prose-indigo dark:prose-invert max-w-none">
        <p>
          アジャイル開発の実践者として、プロダクト開発とチームの成長を両立させることに情熱を持っています。
          MBA取得後、Java講師・アジャイルコンサルタントとしての経験を活かし、現在はプロダクトエンジニアとして
          技術とビジネスの橋渡しをしています。
        </p>
        <p>
          このブログでは、スクラムの実践知識やJavaのデザインパターンを中心に、
          現場で得た知見を体系的に発信しています。
          「学んだことをすぐに実践できる」コンテンツを目指しています。
        </p>
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">スキル</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {skills.map(({ label, level }) => (
          <div class="bg-white dark:bg-gray-800 rounded-xl p-4 border border-gray-200 dark:border-gray-700">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{label}</span>
              <span class="text-sm font-bold text-accent-600 dark:text-accent-400">{level}%</span>
            </div>
            <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-accent-500 to-indigo-500 rounded-full"
                style={`width: ${level}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">学歴</h2>
      <div class="relative">
        <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 hidden md:block"></div>
        <div class="space-y-8">
          {education.map(({ period, degree, school, major, location }) => (
            <div class="flex gap-6">
              <div class="hidden md:flex flex-col items-center">
                <div class="w-12 h-12 rounded-full border-2 bg-emerald-600 border-emerald-600 text-white flex items-center justify-center shrink-0 z-10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/>
                  </svg>
                </div>
              </div>
              <div class="flex-1 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-md transition-shadow">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-sm text-gray-500 dark:text-gray-400">{period}</span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">
                    修士課程
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">{degree}</h3>
                <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-2">
                  <span class="font-medium text-gray-700 dark:text-gray-300">{school}</span>
                  <span>·</span>
                  <span>{location}</span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-sm">{major}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Career Timeline -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">職歴</h2>
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 hidden md:block"></div>

        <div class="space-y-8">
          {timeline.map(({ period, type, title, company, location, description }) => (
            <div class="flex gap-6">
              <!-- Timeline dot -->
              <div class="hidden md:flex flex-col items-center">
                <div class:list={[
                  'w-12 h-12 rounded-full border-2 flex items-center justify-center shrink-0 z-10',
                  type === 'fulltime'
                    ? 'bg-accent-600 border-accent-600 text-white'
                    : 'bg-white dark:bg-gray-900 border-amber-400 text-amber-500',
                ]}>
                  {type === 'fulltime' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20 6h-2.18c.07-.44.18-.88.18-1.36C18 2.51 15.5 0 12.36 0S6.72 2.51 6.72 4.64c0 .48.11.92.18 1.36H5C3.9 6 3 6.9 3 8v12c0 1.1.9 2 2 2h15c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7.64-3.36c1.14 0 2 .87 2 1.96 0 .48-.11.92-.18 1.4h-3.64c-.07-.48-.18-.92-.18-1.4 0-1.09.86-1.96 1.96-1.96z"/>
                    </svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2L1 21h22L12 2zm0 3.83L20.17 19H3.83L12 5.83zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/>
                    </svg>
                  )}
                </div>
              </div>

              <!-- Content card -->
              <div class="flex-1 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-md transition-shadow">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-sm text-gray-500 dark:text-gray-400">{period}</span>
                  <span class:list={[
                    'text-xs font-bold px-2 py-0.5 rounded-full',
                    type === 'fulltime'
                      ? 'bg-accent-100 text-accent-700 dark:bg-accent-900 dark:text-accent-300'
                      : 'bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300',
                  ]}>
                    {type === 'fulltime' ? '正社員' : '非常勤'}
                  </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">{title}</h3>
                <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-3">
                  <span class="font-medium text-gray-700 dark:text-gray-300">{company}</span>
                  <span>·</span>
                  <span>{location}</span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact / Social -->
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">連絡先</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="mailto:zhongtaodylan@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 bg-accent-600 text-white rounded-lg text-sm font-medium hover:bg-accent-700 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          メールを送る
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
