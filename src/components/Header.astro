---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: `${base}/blog/`, label: 'Blog' },
  { href: `${base}/docs/`, label: 'Docs' },
  { href: `${base}/about/`, label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <div class="backdrop-blur-xl bg-white/75 dark:bg-[#000000]/80 border-b border-black/[0.06] dark:border-white/[0.08]">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">

        <!-- Logo -->
        <a
          href={`${base}/`}
          class="text-[15px] font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] hover:opacity-70 transition-opacity duration-200"
          aria-label="Aki's Blog — ホームへ"
        >
          Aki
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-1" aria-label="メインナビゲーション">
          {navLinks.map(({ href, label }) => {
            const isActive = currentPath === href || currentPath.startsWith(href.replace(/\/$/, ''));
            return (
              <a
                href={href}
                class:list={[
                  'px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-200',
                  isActive
                    ? 'text-[#1d1d1f] dark:text-white bg-black/[0.06] dark:bg-white/[0.1]'
                    : 'text-[#6e6e73] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white hover:bg-black/[0.04] dark:hover:bg-white/[0.06]',
                ]}
              >
                {label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2">
          <ThemeToggle />

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-lg text-[#6e6e73] dark:text-[#a1a1a6] hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors duration-200"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden backdrop-blur-xl bg-white/90 dark:bg-[#000000]/90 border-b border-black/[0.06] dark:border-white/[0.08]"
    role="navigation"
    aria-label="モバイルナビゲーション"
  >
    <nav class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="px-3 py-2.5 rounded-xl text-[15px] font-medium text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors duration-200"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- Spacer to prevent content from hiding under fixed header -->
<div class="h-14"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
