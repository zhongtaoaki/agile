---
interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  category?: string;
  href: string;
  type?: 'blog' | 'docs';
}

const { title, description, category, href, type = 'blog' } = Astro.props;

const badgeStyle =
  type === 'docs'
    ? 'text-emerald-600 dark:text-emerald-400'
    : 'text-indigo-600 dark:text-indigo-400';
---

<a
  href={href}
  class="group block rounded-2xl bg-[#f5f5f7] dark:bg-[#1c1c1e] p-6 hover:bg-[#ebebeb] dark:hover:bg-[#2c2c2e] transition-all duration-200"
>
  <div class="flex items-center gap-2 mb-4">
    {category && (
      <span class:list={['text-[12px] font-semibold uppercase tracking-wider', badgeStyle]}>
        {category}
      </span>
    )}
  </div>

  <h3 class="text-[17px] font-semibold text-[#1d1d1f] dark:text-white leading-snug line-clamp-2 mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200">
    {title}
  </h3>

  {description && (
    <p class="text-[14px] text-[#6e6e73] dark:text-[#a1a1a6] line-clamp-2 leading-relaxed mb-5">
      {description}
    </p>
  )}

  <div class="flex items-center justify-end">
    <span class="text-[13px] font-semibold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform duration-200 inline-block" aria-hidden="true">
      →
    </span>
  </div>
</a>
